        {"op": "control_repeat", "TIMES": 4, "SUBSTACK": [
          {"op": "call", "proc": "сторона", "args": {"секунд": 1.5}},
          {"op": "data_changevariableby", "VARIABLE": "круг", "VALUE": 1}
        ]},
        {"op": "looks_sayforsecs", "MESSAGE": {"op": "operator_join", "STRING1": "Кругов: ", "STRING2": {"var": "круг"}}, "SECS": 2}
      ],
      [
        {"op": "event_whenkeypressed", "KEY_OPTION": "пробел"},
        {"op": "control_forever", "SUBSTACK": [
          {"op": "control_if_else",
           "CONDITION": {"op": "operator_lt", "OPERAND1": {"op": "robot_get_sensor_data", "ROBOT_SENSORS": "Датчик1"}, "OPERAND2": 50},
           "SUBSTACK": [{"op": "robot_motors_off"}],
           "SUBSTACK2": [{"op": "robot_motors_on"}]}
        ]}
      ]
    ]
  }]
