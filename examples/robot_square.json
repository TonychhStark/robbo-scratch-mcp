{
  "variables": {"круг": 0},
  "sprites": [{
    "name": "Робот",
    "procedures": [
      {"name": "сторона", "params": [{"name": "секунд", "type": "number"}],
       "body": [
         {"op": "robot_set_direction_to", "ROBOT_DIRECTION": "Вперёд"},
         {"op": "robot_motors_on_for_seconds", "SECONDS": {"arg": "секунд"}},
         {"op": "robot_turnright", "DEGREES": 90}
       ]}
    ],
    "scripts": [
      [
        {"op": "event_whenflagclicked"},
        {"op": "robot_set_motors_power", "POWER": 40},
